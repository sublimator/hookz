# Baked xahaud image. Works without volumes.
# Generated by generate.py — edit there, not here.
#
# First build (from docker/; BASE_IMAGE defaults to the local hookz-conan-deps):
#   docker build -t hookz-conan-deps -f Dockerfile.conan-deps .
#   docker build -t hookz-xahaud .
#
# Incremental rebuild (reuses ccache from previous image):
#   docker build --build-arg PREV_IMAGE=hookz-xahaud:latest -t hookz-xahaud .
#
# Publish (CI pulls the dated tag pinned in .github/workflows/xahaud-integration.yml):
#   docker tag hookz-xahaud ghcr.io/sublimator/hookz-xahaud:<date>-hookz-<sha>
#   docker push ghcr.io/sublimator/hookz-xahaud:<date>-hookz-<sha>
#
# Run:
#   docker run --rm hookz-xahaud "ripple.app.SetHook"
#
# With external tests + writable ccache volume:
#   docker run --rm -v hookz-ccache:/ccache \
#     -v ~/my-hooks/tests:/tests \
#     -e HOOKS_TEST_DIR=/tests \
#     hookz-xahaud "ripple.app.TipBot"
#
# Refresh hookz without rebuilding the image (entrypoint; needs network):
#   docker run -e HOOKZ_REF=main ...
#   docker run -e HOOKZ_REF=<sha> ...
#   docker run -e HOOKZ_SPEC='hookz @ git+https://github.com/sublimator/hookz.git@branch' ...
#   docker run -e HOOKZ_REPO=https://github.com/other/hookz.git -e HOOKZ_REF=...
# Unset HOOKZ_REF/HOOKZ_SPEC → use the hookz baked into the image.
# CI mounts this entrypoint from the checkout so old images still refresh.
#
# ccache layout:
#   /ccache-primed  — read-only file backend baked into image (from reshare)
#   /ccache         — writable local cache (CCACHE_DIR), mountable volume
#   Config lives at /root/.config/xahaud-scripts/ccache.conf (x-run-tests
#   bakes this path into the cmake wrapper toolchain).
#   Build-time: misses write to local + reshare to /ccache-primed.
#   Runtime: hits from /ccache, fallback to /ccache-primed, misses to /ccache.

# Global ARGs (before any FROM, available to all stages)
ARG PREV_IMAGE
ARG BASE_IMAGE=hookz-conan-deps:latest

# Optional: previous image to seed ccache from. Defaults to a dummy stage
# with an empty /ccache-primed dir so COPY --from=prev always succeeds.
FROM ${PREV_IMAGE:-ubuntu:24.04} AS prev
RUN mkdir -p /ccache-primed

FROM ${BASE_IMAGE}

# Extra tools not needed for conan but needed for xahaud build/test
RUN apt-get update && apt-get install -y --no-install-recommends \
    ccache \
    wabt \
    clang-format \
    && rm -rf /var/lib/apt/lists/*

ARG HOOKZ_REPO=https://github.com/sublimator/hookz.git
# Install hookz from main (includes hatch wheel fix: no force-include of
# xahaud_lite on top of packages=["src/hookz"]).
ARG HOOKZ_BRANCH=main
ARG SCRIPTS_REPO=https://github.com/sublimator/xahaud-scripts.git
ARG SCRIPTS_BRANCH=main
ARG XAHAUD_REPO=https://github.com/sublimator/xahaud.git
ARG XAHAUD_BRANCH=external-env-tests
ARG WASI_SDK_VERSION=32
# Node for `hookz build-test-hooks --hooks-compiler` (HOOKZ_HOOKS_COMPILER=1):
# the reference compiler, tequdev/hooks-compiler, runs through npx and needs
# Node >= 20.12. Ubuntu 24.04's nodejs is 18, so the official tarball, pinned
# by sha256 per arch (nodejs.org/dist/v<NODE_VERSION>/SHASUMS256.txt).
ARG NODE_VERSION=22.23.4
ARG NODE_SHA256_X64=b8492284c76a54baf58d61668dd0e41ee0fc98adabf9503d30f05d08f55b4406
ARG NODE_SHA256_ARM64=f7a1e486dbc8b286847815b477d4fb5e9fb963ed4489c3e1588853d685f589f9

# Tools on PATH for external-env-tests (see docs/external-env-tests.md).
#
# hookz is NOT the Python unit-test harness used day-to-day for audit suites.
# Here it is only the CLI xahaud's CMake invokes when your *_test.cpp references
# a hook source ("file:path/to/hook.c"):
#   - hookz build-test-hooks  → embeds WASM into *_test_hooks.h for Env tests
#   - hookz build --coverage  → optional line instrumentation for real xahaud runs
#   - ships xahaud_lite headers so compile works without a full tree on the host
# Install from git@main must produce a wheel (hatch packages= already includes
# xahaud_lite; do not force-include that tree twice or hatchling fails on
# duplicate paths like hookz/xahaud_lite/hook/error.h).
#
# xahaud-scripts provides x-run-tests (conan + cmake + ccache + run the suite).
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"
RUN uv tool install "hookz @ git+${HOOKZ_REPO}@${HOOKZ_BRANCH}"
RUN uv tool install "xahaud-scripts @ git+${SCRIPTS_REPO}@${SCRIPTS_BRANCH}"

ARG TARGETARCH
RUN if [ "$TARGETARCH" = "arm64" ]; then ARCH=arm64; SUM=$NODE_SHA256_ARM64; \
    else ARCH=x64; SUM=$NODE_SHA256_X64; fi \
    && curl -sSLo /tmp/node.tgz https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.gz \
    && echo "$SUM  /tmp/node.tgz" | sha256sum -c - \
    && tar xzf /tmp/node.tgz -C /opt && rm /tmp/node.tgz \
    && ln -s /opt/node-v${NODE_VERSION}-linux-${ARCH} /opt/node
ENV PATH="/opt/node/bin:${PATH}"
# Fetch the pinned hooks-compiler into npm's cache now, at the version the
# installed hookz pins, so a run needs no network for it.
RUN /root/.local/share/uv/tools/hookz/bin/python -c \
    "from hookz.hooks_compiler import ensure_available; ensure_available()"

RUN ARCH=$([ "$TARGETARCH" = "arm64" ] && echo "arm64" || echo "x86_64") \
    && curl -sSL https://github.com/WebAssembly/wasi-sdk/releases/download/wasi-sdk-${WASI_SDK_VERSION}/wasi-sdk-${WASI_SDK_VERSION}.0-${ARCH}-linux.tar.gz \
    | tar xz -C /opt \
    && ln -s /opt/wasi-sdk-${WASI_SDK_VERSION}.0-${ARCH}-linux /opt/wasi-sdk
ENV WASI_SDK_PATH=/opt/wasi-sdk

# Pull latest xahaud source (base image has a shallow clone that may be stale).
# From XAHAUD_REPO by URL, not the base's `origin`: a base built before the
# branch moved to sublimator/xahaud still has Xahau/xahaud as origin.
RUN git fetch ${XAHAUD_REPO} ${XAHAUD_BRANCH} && git checkout FETCH_HEAD

# ccache setup:
# - Seed /ccache-primed from previous image (empty on first build)
# - Use /ccache-build as temporary local cache during build
# - Reshare hits into /ccache-primed so the final image has a warm cache
ENV CCACHE_DIR=/ccache-build
ENV CCACHE_CONFIGPATH=/root/.config/xahaud-scripts/ccache.conf
ENV CCACHE_NOHASHDIR=true
RUN mkdir -p /ccache-build /ccache-primed /ccache /root/.config/xahaud-scripts
COPY --from=prev /ccache-primed/ /ccache-primed/
RUN printf 'remote_storage = file:/ccache-primed\nreshare = true\nhash_dir = false\nmax_size = 10G\n' > /root/.config/xahaud-scripts/ccache.conf

# Build xahaud using x-run-tests (handles conan, cmake, ccache wrapper toolchain)
# -j defaults to nproc; override with BUILD_JOBS to avoid OOM on high-CPU/low-RAM
ARG BUILD_JOBS
RUN x-run-tests --times=0 --ccache --reconfigure-build ${BUILD_JOBS:+-j $BUILD_JOBS}

# Validate
RUN ./build/rippled --version || true

# Finalize ccache:
# - Drop temporary build cache (don't ship it)
# - Repoint config to read-only primed cache for runtime
# - Set CCACHE_DIR to /ccache for runtime writes
RUN rm -rf /ccache-build \
    && printf 'remote_storage = file:/ccache-primed|read-only\nhash_dir = false\nmax_size = 10G\n' > /root/.config/xahaud-scripts/ccache.conf
ENV CCACHE_DIR=/ccache

COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["ripple.app.SetHook"]
